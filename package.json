{
  "devDependencies": {
    "copyfiles": "^2.4.1",
    "esbuild": "^0.25.9",
    "typescript": "^5.9.2"
  },
  "scripts": {
    "build": "npm run build:bundle && npm run build:copy",
    "build:bundle": "esbuild src/index.ts --bundle --format=esm --outfile=dist/index.mjs --target=es2020",
    "build:copy": "copyfiles -u 1 \"src/**/!(*.ts)\" dist"
  },
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "qrcode": "^1.5.4",
    "zod": "^4.1.5"
  }
}
